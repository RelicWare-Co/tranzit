{
	"name": "@tranzit/server",
	"scripts": {
		"db:generate": "drizzle-kit generate --config drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
		"db:push": "drizzle-kit push --config drizzle.config.ts",
		"dev": "bun run --env-file ../../.env --hot src/index.ts",
		"maildev": "maildev --smtp 1025 --web 1080 --ip 127.0.0.1 --web-ip 127.0.0.1",
		"seed": "bun run --env-file ../../.env scripts/seed.ts",
		"test": "vitest run --maxWorkers=1"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.6.23",
		"@libsql/client": "^0.17.4",
		"@orpc/server": "^1.14.6",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.6.23",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"evlog": "^2.19.2",
		"hono": "^4.12.27",
		"nodemailer": "^9.0.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@better-auth/memory-adapter": "^1.6.23",
		"@better-auth/utils": "^0.4.2",
		"@types/bcryptjs": "^3.0.0",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.0",
		"@types/nodemailer": "^8.0.1",
		"drizzle-kit": "^0.31.10",
		"maildev": "^2.2.1",
		"tsx": "^4.22.5",
		"vitest": "^4.1.9"
	}
}
